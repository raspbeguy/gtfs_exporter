{
  "uid": "gtfs-rt-status",
  "title": "GTFS-Realtime status board",
  "tags": [
    "gtfs-rt",
    "transit",
    "prometheus"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "timezone": "browser",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "description": "One network at a time. A status board, not a journey planner: it says which lines are running and which are disrupted, and it cannot say when the next vehicle reaches a stop.",
  "links": [
    {
      "title": "GTFS-Realtime dashboards",
      "type": "dashboards",
      "tags": [
        "gtfs-rt"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "tooltip": "",
      "url": "",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gtfs_rt_up, job)",
        "label": "Job",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {}
      },
      {
        "name": "network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gtfs_rt_up{job=~\"$job\"}, network)",
        "label": "Network",
        "description": "The board shows one network. Metrics from different networks are not comparable and must never be summed together.",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {}
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(gtfs_rt_up{job=~\"$job\",network=\"$network\"}, instance)",
        "label": "Feed",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Network at a glance",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Lines running",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Lines with at least one trip in the feed right now. A line that has stopped for the night is not counted.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max by (route_id) (gtfs_rt_route_trip_updates{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Lines with a disruption",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Lines named by an alert that is in force now.",
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(count by (route_id) (gtfs_rt_route_alerts{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Network-wide disruptions",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "An alert that names the agency or a whole mode affects every line, so it appears here rather than against one line.",
      "gridPos": {
        "x": 10,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(gtfs_rt_alerts_unresolved{job=~\"$job\",network=\"$network\",instance=~\"$instance\",scope=~\"agency|route_type\"}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Trips late",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Trips running later than the threshold that the module sets. The default is five minutes.",
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (route_id) (gtfs_rt_route_trips_late{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Trips cancelled",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "A cancelled trip is one the operator has withdrawn. A stop-cancellation notice, which skips a stop on a trip that still runs, is not a cancellation and is not counted here.",
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(max by (route_id) (gtfs_rt_route_trips_cancelled{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "title": "Line by line",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Line status",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "One row per line of the loaded timetable. A line with no trips right now still appears, with blanks, so that a line which has stopped running is visible rather than missing.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (route_id, route_short_name, route_type, agency_id) (gtfs_static_route_info{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (route_id) (gtfs_rt_route_trip_updates{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (route_id, threshold) (gtfs_rt_route_trips_late{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (route_id) (gtfs_rt_route_vehicles{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (route_id) (gtfs_rt_route_trips_cancelled{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (route_id) (gtfs_rt_route_alerts{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "route_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "job": true,
              "job 1": true,
              "instance": true,
              "instance 1": true,
              "network": true,
              "network 1": true,
              "__name__": true,
              "Value #A": true,
              "threshold": true,
              "agency_id": true
            },
            "renameByName": {
              "route_short_name": "Line",
              "route_id": "Identifier",
              "route_type": "Mode",
              "Value #B": "Trips",
              "Value #C": "Late",
              "Value #D": "Vehicles",
              "Value #E": "Cancelled",
              "Value #F": "Alerts"
            },
            "indexByName": {
              "route_short_name": 0,
              "route_id": 1,
              "route_type": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Line"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "Punctuality by line, 90th percentile",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Needs per_route_delay on the module. Nine trips in ten on this line are no later than this. Negative means early.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.9, sum by (route_id, le) (gtfs_rt_route_trip_delay_seconds_bucket{job=~\"$job\",network=\"$network\",instance=~\"$instance\"}))",
          "legendFormat": "{{route_id}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Worse than the same hour last week?",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Above zero means more late trips than the same hour seven days ago. It needs a week of history before it says anything.",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(gtfs_rt_route_trips_late{job=~\"$job\",network=\"$network\",instance=~\"$instance\"}) - sum(gtfs_rt_route_trips_late{job=~\"$job\",network=\"$network\",instance=~\"$instance\"} offset 7d)",
          "legendFormat": "late trips against last week",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "title": "Disruptions",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 21,
      "title": "Alerts in force, by effect",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Every alert in force, whether or not it names a line.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (effect) (gtfs_rt_alerts{job=~\"$job\",network=\"$network\",instance=~\"$instance\",active=\"true\"})",
          "legendFormat": "{{effect}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 22,
      "title": "Alerts that name no line",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "agency and route_type affect the whole network. unresolved_trip means the alert named a trip that the timetable does not hold, which happens when the alert feed and the static feed disagree on how a trip is identified.",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (scope) (gtfs_rt_alerts_unresolved{job=~\"$job\",network=\"$network\",instance=~\"$instance\"})",
          "legendFormat": "{{scope}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 30,
      "title": "Where these numbers come from",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "A producer value is what the operator published. A computed value is what this exporter derived from the timetable, which is a weaker reading. A feed that publishes no delay of its own can only be computed.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "gtfs_rt_delay_source_info{job=~\"$job\",network=\"$network\",instance=~\"$instance\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true
            },
            "renameByName": {
              "instance": "Feed",
              "network": "Network",
              "source": "Source"
            }
          }
        }
      ]
    }
  ]
}